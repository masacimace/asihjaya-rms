# Asihjaya RMS — template production tanpa secret asli.
# Salin/generate menjadi .env.production melalui:
# npm run env:prepare:production
# npm run env:validate:production
# Jangan commit .env.production dan jangan menampilkan `docker compose config`
# tanpa --quiet karena output dapat memuat secret.

# -----------------------------------------------------------------------------
# Deployment / container
# -----------------------------------------------------------------------------
NODE_ENV=production
ASIHJAYA_IMAGE=asihjaya-rms:production
ASIHJAYA_MIGRATOR_IMAGE=asihjaya-rms-migrator:production
ASIHJAYA_ENV_FILE=.env.production
ASIHJAYA_BIND_ADDRESS=127.0.0.1
ASIHJAYA_APP_PORT=3000
APP_REVISION=unknown
APP_BUILD_DATE=unknown

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Asihjaya Retail Management System
NEXT_PUBLIC_APP_URL=https://ajsystem.id
APP_URL=https://ajsystem.id
INTERNAL_RENDER_ORIGIN=http://127.0.0.1:3000
DEFAULT_ORGANIZATION_SLUG=asihjaya
SERVER_ACTION_BODY_SIZE_LIMIT=20mb
PORT=3000

# -----------------------------------------------------------------------------
# PostgreSQL
# POSTGRES_PASSWORD dan password pada DATABASE_URL akan disinkronkan generator.
# -----------------------------------------------------------------------------
POSTGRES_DB=asihjaya_rms
POSTGRES_USER=asihjaya_app
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://asihjaya_app:CHANGE_ME@db:5432/asihjaya_rms

# -----------------------------------------------------------------------------
# Database deployment / migration safety
# Destructive migration harus tetap false kecuali backup dan review eksplisit selesai.
# -----------------------------------------------------------------------------
DATABASE_MIGRATION_LOCK_KEY=718143293674
DATABASE_MIGRATION_READY_TIMEOUT_MS=120000
DATABASE_MIGRATION_LOCK_TIMEOUT_MS=120000
DATABASE_MIGRATION_DDL_LOCK_TIMEOUT_MS=30000
DATABASE_MIGRATION_STATEMENT_TIMEOUT_MS=900000
DATABASE_MIGRATION_ALLOW_DESTRUCTIVE=false
DATABASE_MIGRATION_APPROVAL_REFERENCE=

# -----------------------------------------------------------------------------
# Authentication dan application secrets
# Setiap value wajib unik. Generator menghasilkan entropy yang sesuai.
# -----------------------------------------------------------------------------
SESSION_SECRET=CHANGE_ME
RECEIPT_VERIFICATION_SECRET=CHANGE_ME
CUSTOMER_HISTORY_SESSION_SECRET=CHANGE_ME
CUSTOMER_HISTORY_PIN_PEPPER=CHANGE_ME
SECURITY_RATE_LIMIT_SECRET=CHANGE_ME
PDF_RENDER_TOKEN_SECRET=CHANGE_ME
HARDWARE_AGENT_CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME

# -----------------------------------------------------------------------------
# Reverse proxy / client IP
# Target: Browser -> Cloudflare -> reverse proxy VPS -> Next.js.
# -----------------------------------------------------------------------------
TRUST_PROXY=true
TRUST_PROXY_HOPS=2

# -----------------------------------------------------------------------------
# Authentication and application rate limits
# -----------------------------------------------------------------------------
LOGIN_RATE_LIMIT_IDENTIFIER_FAILURES=10
LOGIN_RATE_LIMIT_IP_FAILURES=20
LOGIN_RATE_LIMIT_WINDOW_MS=800000
LOGIN_RATE_LIMIT_BLOCK_MS=800000
SECURITY_RATE_LIMIT_RETENTION_HOURS=48

PDF_RATE_LIMIT_ACTOR_REQUESTS=12
PDF_RATE_LIMIT_IP_REQUESTS=30
PDF_RATE_LIMIT_WINDOW_MS=60000
PDF_RATE_LIMIT_BLOCK_MS=60000

# -----------------------------------------------------------------------------
# Bootstrap seed — hanya digunakan saat bootstrap awal.
# Setelah seed, simpan credential administrator di password manager.
# -----------------------------------------------------------------------------
BOOTSTRAP_ORGANIZATION_NAME=Asihjaya
BOOTSTRAP_ORGANIZATION_SLUG=asihjaya
BOOTSTRAP_OUTLET_CODE=TOKO-BG
BOOTSTRAP_OUTLET_NAME=Bantar Gebang
BOOTSTRAP_REGISTER_CODE=POS-BG1
BOOTSTRAP_REGISTER_NAME=Kasir Bantar Gebang 1
BOOTSTRAP_ADMIN_NAME=System Administrator
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@asihjaya.local
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME

# -----------------------------------------------------------------------------
# Hardware Hub server integration
# -----------------------------------------------------------------------------
HARDWARE_JOB_COMPLETED_RETENTION_DAYS=5
HARDWARE_JOB_CANCELLED_RETENTION_DAYS=5
HARDWARE_JOB_FAILED_RETENTION_DAYS=5
HARDWARE_JOB_STALE_MINUTES=10
HARDWARE_AGENT_STALE_MINUTES=5

HARDWARE_AGENT_AUTH_MODE=signed-only
HARDWARE_AGENT_SIGNATURE_TOLERANCE_MS=300000
HARDWARE_AGENT_NONCE_TTL_MS=600000
HARDWARE_AGENT_SIGNED_BODY_MAX_BYTES=1048576
HARDWARE_AGENT_AUTH_FAILURE_WINDOW_MS=300000
HARDWARE_AGENT_AUTH_FAILURE_LIMIT_PER_AGENT=20
HARDWARE_AGENT_AUTH_FAILURE_LIMIT_PER_IP=60

# Dipakai saat membuat credential outlet Hardware Hub, bukan oleh web request biasa.
HARDWARE_AGENT_ORGANIZATION_SLUG=asihjaya
HARDWARE_AGENT_OUTLET_CODE=TOKO-BG
HARDWARE_AGENT_REGISTER_CODE=POS-BG1
HARDWARE_AGENT_CODE=TOKO-BG1
HARDWARE_AGENT_NAME=Kasir Bantar Gebang 1
HARDWARE_AGENT_SECRET=CHANGE_ME

# -----------------------------------------------------------------------------
# Operational thresholds
# -----------------------------------------------------------------------------
SHIFT_CASH_VARIANCE_CRITICAL_AMOUNT=100000
LARGE_CASH_OUT_NOTIFICATION_AMOUNT=1000000

NOTIFICATION_SUCCESS_AUTO_RESOLVE_DAYS=7
NOTIFICATION_INFO_AUTO_RESOLVE_DAYS=14
NOTIFICATION_WARNING_AUTO_RESOLVE_DAYS=30
NOTIFICATION_RESOLVED_AUTO_ARCHIVE_DAYS=30
NOTIFICATION_MAINTENANCE_INTERVAL_MINUTES=5
NOTIFICATION_ANTI_SPAM_WINDOW_MINUTES=15

HARDWARE_PENDING_WARNING_SECONDS=300
HARDWARE_SUBMITTED_WARNING_SECONDS=120
HARDWARE_FAILURE_RATE_WARNING_PERCENT=10

# -----------------------------------------------------------------------------
# Image storage
# Local volume aman untuk fondasi awal. S3-compatible dapat diaktifkan kemudian.
# -----------------------------------------------------------------------------
IMAGE_STORAGE_DRIVER=local
IMAGE_STORAGE_ROOT=.data/uploads
IMAGE_MAX_UPLOAD_MB=5

IMAGE_STORAGE_BUCKET=
IMAGE_STORAGE_ENDPOINT=
IMAGE_STORAGE_REGION=auto
IMAGE_STORAGE_ACCESS_KEY_ID=
IMAGE_STORAGE_SECRET_ACCESS_KEY=
IMAGE_STORAGE_FORCE_PATH_STYLE=false

LEGACY_IMAGE_ALLOWED_HOSTS=asihjaya.com
LEGACY_IMAGE_DOWNLOAD_TIMEOUT_MS=12000
LEGACY_IMAGE_DOWNLOAD_MAX_MB=8

# -----------------------------------------------------------------------------
# Receipt and document profile
# -----------------------------------------------------------------------------
RECEIPT_OUTLET_INSTAGRAM=@asihjaya_bantargebang
RECEIPT_VENDOR_OUTLET_NAME=Pasar Bantar Gebang
RECEIPT_VENDOR_OUTLET_ADDRESS=Jl. Belakang Ps. Bantar Gebang, RT.003/RW.009, Bantargebang, Kota Bekasi, Jawa Barat 17151
RECEIPT_VENDOR_OUTLET_PHONE=082118068889
RECEIPT_VENDOR_OUTLET_INSTAGRAM=@asihjaya_bantargebang

RECEIPT_DOCUMENT_PROFILE_ID=receipt_a4_landscape_v1
RECEIPT_OVERLAY_OFFSET_X_MM=0
RECEIPT_OVERLAY_OFFSET_Y_MM=0
RECEIPT_OVERLAY_SCALE=1

# -----------------------------------------------------------------------------
# PDF rendering / Playwright
# -----------------------------------------------------------------------------
PDF_RENDER_TOKEN_TTL_MS=60000
PDF_RENDER_MAX_CONCURRENCY=1
PDF_RENDER_MAX_QUEUE=10
PDF_RENDER_QUEUE_WAIT_TIMEOUT_MS=15000
PDF_RENDER_TIMEOUT_MS=45000
PDF_RENDER_DISABLE_SANDBOX=false
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=

# -----------------------------------------------------------------------------
# Observability
# Runtime logging/monitoring variables akan ditambahkan pada Tahap 1D.6.
# -----------------------------------------------------------------------------
