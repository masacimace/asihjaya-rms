# Aplikasi #nama domain online: ajsystem.id
NEXT_PUBLIC_APP_NAME=Asihjaya Retail Management System
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Origin internal tetap untuk Playwright. Jangan bentuk dari Host/X-Forwarded-Host request.
# Default aman bila kosong: http://127.0.0.1:$PORT
INTERNAL_RENDER_ORIGIN=http://127.0.0.1:3000

# Organization yang digunakan pada halaman login internal
DEFAULT_ORGANIZATION_SLUG=asihjaya

# Database lokal melalui Docker Compose
DATABASE_URL=postgresql://asihjaya:asihjaya_dev@localhost:5432/asihjaya_rms

# Gunakan random secret minimal 32 karakter.
# Jangan gunakan value contoh ini untuk staging/production.
SESSION_SECRET=mpSw82atEtq35QAmSjPUFfwQ3jqnPuvxg2Wi7Ib676I

# Secret khusus QR nota. Pisahkan dari SESSION_SECRET agar rotasi session internal
# node -e "const c=require('crypto'); for (const name of ['RECEIPT_VERIFICATION_SECRET','CUSTOMER_HISTORY_SESSION_SECRET','CUSTOMER_HISTORY_PIN_PEPPER']) console.log(name+'='+c.randomBytes(32).toString('base64url'))"
# tidak membatalkan QR nota baru. Minimal 32 karakter acak.
RECEIPT_VERIFICATION_SECRET=6z8cVemPH6LcEKicl9wknk83EZrH3vQtdxXHWgRyeeU

# Secret khusus hashing session histori pelanggan. Minimal 32 karakter acak.
CUSTOMER_HISTORY_SESSION_SECRET=IhnhgOqxINR0t_17wfmyu8jOkdZNbvivfZvDOxzA90g

# Pepper khusus PIN pelanggan sebelum scrypt. Simpan stabil dan jangan gunakan ulang
# untuk kebutuhan lain. Kehilangan value ini mengharuskan reset seluruh PIN pelanggan.
CUSTOMER_HISTORY_PIN_PEPPER=bbfMuVkN1QuiuvZpP49awNndEg31DreYpxxNfE

# Bootstrap organization
BOOTSTRAP_ORGANIZATION_NAME=Asihjaya
BOOTSTRAP_ORGANIZATION_SLUG=asihjaya

# Bootstrap outlet
BOOTSTRAP_OUTLET_CODE=TOKO-BG
BOOTSTRAP_OUTLET_NAME=Bantar Gebang

# Bootstrap register
BOOTSTRAP_REGISTER_CODE=POS-BG1
BOOTSTRAP_REGISTER_NAME=Kasir Bantar Gebang 1

# Bootstrap administrator - development only. Ganti sebelum staging/production.
BOOTSTRAP_ADMIN_NAME=System Administrator
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@asihjaya.local
BOOTSTRAP_ADMIN_PASSWORD=asihjaya-retail@2026

# Hardware job cleanup & retention.
# Cleanup hanya menghapus job terminal lama: completed, cancelled, failed.
HARDWARE_JOB_COMPLETED_RETENTION_DAYS=5
HARDWARE_JOB_CANCELLED_RETENTION_DAYS=5
HARDWARE_JOB_FAILED_RETENTION_DAYS=5

# Hardware job auto-recovery.
# Job claimed/printing yang tidak update melebihi nilai ini dianggap macet.
HARDWARE_JOB_STALE_MINUTES=10

#Default stale agent threshold=5 menit
HARDWARE_AGENT_STALE_MINUTES=5

# Hardware agent bootstrap script.
# Jalankan dengan: npm run hardware:agent:create
HARDWARE_AGENT_ORGANIZATION_SLUG=asihjaya
HARDWARE_AGENT_OUTLET_CODE=TOKO-BG
HARDWARE_AGENT_REGISTER_CODE=POS-BG1
HARDWARE_AGENT_CODE=TOKO-BG1
HARDWARE_AGENT_NAME=Kasir Bantar Gebang 1
HARDWARE_AGENT_SECRET=WE_yOT4d0NHE6PN3jaswEwuf_Ic0GeMxObFPwF7lKI7LKqc13GbLbfFxkZdbTJQ6

# Enkripsi credential agent di database dan verifikasi request HMAC.
# Gunakan secret acak yang berbeda dari seluruh secret aplikasi lain.
HARDWARE_AGENT_CREDENTIAL_ENCRYPTION_KEY=CfXFvURAKo7sbajoSbHHE-iFF9szJUf9BPI860wEpDQ
# dual = request signing + compatibility secret lama selama rollout.
# signed-only = wajib request signing; gunakan setelah semua outlet selesai migrasi.
# legacy-only = emergency rollback saja.
HARDWARE_AGENT_AUTH_MODE=signed-only
HARDWARE_AGENT_SIGNATURE_TOLERANCE_MS=300000
HARDWARE_AGENT_NONCE_TTL_MS=600000
HARDWARE_AGENT_SIGNED_BODY_MAX_BYTES=1048576
HARDWARE_AGENT_AUTH_FAILURE_WINDOW_MS=300000
HARDWARE_AGENT_AUTH_FAILURE_LIMIT_PER_AGENT=20
HARDWARE_AGENT_AUTH_FAILURE_LIMIT_PER_IP=60

# Konfigurasi Shift Cash Variance. Gunakan nilai default.
SHIFT_CASH_VARIANCE_CRITICAL_AMOUNT=100000
LARGE_CASH_OUT_NOTIFICATION_AMOUNT=1000000

# Notification Center maintenance & anti-spam.
# Event actionable/critical tidak pernah auto-resolve hanya karena umur.
NOTIFICATION_SUCCESS_AUTO_RESOLVE_DAYS=7
NOTIFICATION_INFO_AUTO_RESOLVE_DAYS=14
NOTIFICATION_WARNING_AUTO_RESOLVE_DAYS=30
NOTIFICATION_RESOLVED_AUTO_ARCHIVE_DAYS=30
NOTIFICATION_MAINTENANCE_INTERVAL_MINUTES=5
NOTIFICATION_ANTI_SPAM_WINDOW_MINUTES=15

# Penyimpanan foto. Gunakan local saat development dan s3 saat staging/production.
IMAGE_STORAGE_DRIVER=local
IMAGE_STORAGE_ROOT=.data/uploads
IMAGE_MAX_UPLOAD_MB=5

# Konfigurasi S3-compatible (Cloudflare R2, Backblaze B2, atau AWS S3).
# Aktifkan dengan IMAGE_STORAGE_DRIVER=s3. Jangan commit credential asli.
IMAGE_STORAGE_BUCKET=
IMAGE_STORAGE_ENDPOINT=
IMAGE_STORAGE_REGION=auto
IMAGE_STORAGE_ACCESS_KEY_ID=
IMAGE_STORAGE_SECRET_ACCESS_KEY=
IMAGE_STORAGE_FORCE_PATH_STYLE=false

# WhatsApp Automation Report untuk phase berikutnya.
# WHATSAPP_CLOUD_API_VERSION=v20.0
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=

# Midtrans Payment Gateway untuk phase berikutnya.
# MIDTRANS_ENVIRONMENT=sandbox
# MIDTRANS_SERVER_KEY=
# MIDTRANS_CLIENT_KEY=
# MIDTRANS_MERCHANT_ID=
# MIDTRANS_WEBHOOK_SECRET=

# Hardware Hub operational hardening note:
# Agent lokal punya REQUEST_TIMEOUT_MS dan PRINT_COMMAND_TIMEOUT_MS di hardware-hub/.env.
# Server menolak duplikat active job untuk source/job type yang sama tanpa perlu env tambahan.

# Hardware Hub operational observability thresholds.
# Pending lebih lama dari nilai ini menampilkan warning di dashboard.
HARDWARE_PENDING_WARNING_SECONDS=300

# Submitted tanpa acknowledgement final lebih lama dari nilai ini dianggap stale.
HARDWARE_SUBMITTED_WARNING_SECONDS=120

# Warning failure rate aktif setelah minimal 5 job terminal dalam 24 jam.
HARDWARE_FAILURE_RATE_WARNING_PERCENT=10

# Receipt outlet contact.
# Instagram dipakai di receipt full design karena belum ada field Instagram per outlet di database.
RECEIPT_OUTLET_INSTAGRAM=@asihjaya_bantargebang

# Receipt vendor static artwork copy.
# Isi nilai ini dengan copy final yang akan dicetak vendor pada kertas nota custom.
# Jika kosong, vendor artwork memakai data sample/outlet preview sebagai fallback.
RECEIPT_VENDOR_OUTLET_NAME=Pasar Bantar Gebang
RECEIPT_VENDOR_OUTLET_ADDRESS=Jl. Belakang Ps. Bantar Gebang, RT.003/RW.009, Bantargebang, Kec. Bantar Gebang, Kota Bks, Jawa Barat 17151
RECEIPT_VENDOR_OUTLET_PHONE=082118068889
RECEIPT_VENDOR_OUTLET_INSTAGRAM=@asihjaya_bantargebang

# Receipt document profile.
# Gunakan receipt_a4_landscape_v1 untuk A4 Landscape
# receipt_a5_landscape_v1 untuk A5 Landscape.
RECEIPT_DOCUMENT_PROFILE_ID=receipt_a4_landscape_v1

# Receipt pre-printed overlay calibration.
# Gunakan saat printer fisik sedikit geser di atas kertas nota custom vendor
# X positif = geser overlay ke kanan, X negatif = ke kiri
# Y positif = geser overlay ke bawah, Y negatif = ke atas
# Print terlalu kiri   → naikkan RECEIPT_OVERLAY_OFFSET_X_MM
# Print terlalu kanan  → turunkan RECEIPT_OVERLAY_OFFSET_X_MM
# Print terlalu atas   → naikkan RECEIPT_OVERLAY_OFFSET_Y_MM
# Print terlalu bawah  → turunkan RECEIPT_OVERLAY_OFFSET_Y_MM
# Ukuran terlalu kecil → naikkan RECEIPT_OVERLAY_SCALE sedikit
# Ukuran terlalu besar → turunkan RECEIPT_OVERLAY_SCALE sedikit
# Scale 1 = ukuran normal; rentang aman 0.9-1.1
RECEIPT_OVERLAY_OFFSET_X_MM=0
RECEIPT_OVERLAY_OFFSET_Y_MM=0
RECEIPT_OVERLAY_SCALE=1

# Receipt PDF rendering (Playwright/Chromium).
# Production Docker image already includes matching Chromium runtime.
# Secret capability render harus berbeda dari SESSION_SECRET dan secret lain.
# generate dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PDF_RENDER_TOKEN_SECRET=aVHNyMTDSqaax8GrSe7ehlsh0I6sEoMUYesy6DNFMKM
PDF_RENDER_TOKEN_TTL_MS=60000
PDF_RENDER_MAX_CONCURRENCY=1
PDF_RENDER_MAX_QUEUE=10
PDF_RENDER_QUEUE_WAIT_TIMEOUT_MS=15000
PDF_RENDER_TIMEOUT_MS=45000

# Sandbox aktif secara default. Ubah ke true hanya bila runtime Linux yang sudah
# diisolasi tidak mendukung Chromium sandbox dan setelah smoke test production.
PDF_RENDER_DISABLE_SANDBOX=false

# Optional local override when Playwright browser bundle is unavailable.
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=
