{
  "name": "asihjaya-rms",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "routes:check": "tsx scripts/check-routes.ts",
    "check:customer-history-pin": "tsx scripts/check-customer-history-pin.ts",
    "check:receipt-token": "tsx scripts/check-receipt-token.ts",
    "check:pdf-render-security": "tsx scripts/check-pdf-render-security.ts",
    "check:hardware-agent-signing": "tsx scripts/check-hardware-agent-request-signing.ts",
    "check:business-timezone": "tsx scripts/check-business-timezone.ts",
    "check:stabilization": "npm run routes:check && npm run check:security && npm run check:business",
    "hardware:agent:create": "tsx scripts/create-hardware-agent.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:fresh:local": "tsx scripts/reset-local-database.ts",
    "check:http-security": "tsx scripts/check-http-security.ts",
    "check:quality-config": "tsx scripts/check-quality-config.ts",
    "check:source-hygiene": "tsx scripts/check-source-hygiene.ts",
    "check:database": "tsx scripts/check-database-migrations.ts",
    "check:database:live": "tsx scripts/check-database-migrations.ts --database",
    "check:quality": "npm run check:quality-config && npm run check:source-hygiene && npm run check:database",
    "check:security": "npm run check:customer-history-pin && npm run check:receipt-token && npm run check:pdf-render-security && npm run check:hardware-agent-signing && npm run check:http-security",
    "check:business": "npm run check:business-timezone && npm run check:legacy-product-migration",
    "check:hardware": "npm --prefix hardware-hub run check:ci",
    "check:static": "npm run lint && npm run typecheck && npm run routes:check",
    "check:all": "npm run check:quality && npm run check:static && npm run check:security && npm run check:business && npm run check:hardware && npm run build",
    "test:financial": "tsx scripts/run-financial-concurrency-tests.ts",
    "test:concurrency": "npm run test:financial && npm run test:migration:cutover",
    "test:integration": "npm run test:concurrency",
    "test:financial:local": "tsx scripts/run-financial-concurrency-local.ts",
    "check:critical": "npm run check:all && npm run test:concurrency",
    "check:legacy-product-migration": "tsx scripts/check-legacy-product-migration.ts",
    "test:migration:cutover": "tsx scripts/run-legacy-migration-cutover-tests.ts",
    "test:migration:cutover:local": "tsx scripts/run-legacy-migration-cutover-local.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.21.0",
    "next": "^16.0.0",
    "pg": "^8.22.0",
    "playwright": "1.61.0",
    "react": "^19.2.0",
    "react-barcode": "^1.6.1",
    "react-dom": "^19.2.0",
    "react-zxing": "^3.0.0",
    "sharp": "^0.34.4",
    "tailwind-merge": "^3.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
