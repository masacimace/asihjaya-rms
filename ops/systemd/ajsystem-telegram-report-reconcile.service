[Unit]
Description=AJSystem Telegram periodic report reconciliation
Documentation=file:/opt/asihjaya-rms/app/docs/development/telegram-reporting-stage-2c.md
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

ConditionPathExists=/opt/asihjaya-rms/app/compose.production.yaml
ConditionPathExists=/etc/asihjaya-rms/production.env
ConditionPathExists=/var/lib/asihjaya-rms/deployments/current.env
ConditionPathExists=/var/run/docker.sock
ConditionFileIsExecutable=/usr/local/sbin/ajsystem-telegram-reporting

[Service]
Type=oneshot

User=ubuntu
Group=ubuntu
SupplementaryGroups=docker
WorkingDirectory=/opt/asihjaya-rms/app

Environment=HOME=/tmp
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/local/sbin/ajsystem-telegram-reporting reconcile

UMask=0077
TimeoutStartSec=15min
TimeoutStopSec=90s

Nice=10
CPUWeight=20
IOWeight=20
OOMScoreAdjust=500

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ajsystem-telegram-report-reconcile

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RemoveIPC=true

ReadWritePaths=/run/docker.sock
ReadWritePaths=/var/lib/asihjaya-rms/telegram-reporting
