#!/usr/bin/env bash
set -Eeuo pipefail
umask 027

ACTION="${1:-}"
PROJECT_DIR="${ASIHJAYA_PROJECT_DIR:-/opt/asihjaya-rms/app}"
ENV_FILE="${ASIHJAYA_ENV_FILE:-/etc/asihjaya-rms/production.env}"
COMPOSE_FILE="${ASIHJAYA_COMPOSE_FILE:-$PROJECT_DIR/compose.production.yaml}"
STATE_ROOT="${ASIHJAYA_TELEGRAM_STATE_ROOT:-/var/lib/asihjaya-rms/telegram-reporting}"
DEPLOYMENT_STATE_ROOT="${ASIHJAYA_DEPLOYMENT_STATE_ROOT:-/var/lib/asihjaya-rms/deployments}"
RELEASE_ENV_FILE="${ASIHJAYA_RELEASE_ENV_FILE:-$DEPLOYMENT_STATE_ROOT/current.env}"
DEPLOYMENT_USER="${ASIHJAYA_DEPLOYMENT_USER:-ubuntu}"

usage() {
  cat <<'USAGE'
Usage:
  ajsystem-telegram-reporting delivery
  ajsystem-telegram-reporting reconcile
  ajsystem-telegram-reporting status

Environment overrides:
  ASIHJAYA_PROJECT_DIR
  ASIHJAYA_ENV_FILE
  ASIHJAYA_COMPOSE_FILE
  ASIHJAYA_TELEGRAM_STATE_ROOT
  ASIHJAYA_DEPLOYMENT_STATE_ROOT
  ASIHJAYA_RELEASE_ENV_FILE
  ASIHJAYA_DEPLOYMENT_USER
USAGE
}

fail() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 64
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "command wajib tidak tersedia: $1"
}

assert_absolute() {
  [[ "$2" == /* ]] || fail "$1 harus absolute: $2"
}

read_env_file_value() {
  local file_path="$1" key="$2" line value
  line="$(grep -E "^${key}=" "$file_path" | tail -n 1 || true)"
  value="${line#*=}"
  value="${value%$'\r'}"
  if [[ "$value" == \"*\" && "$value" == *\" ]]; then
    value="${value:1:${#value}-2}"
  elif [[ "$value" == \'*\' && "$value" == *\' ]]; then
    value="${value:1:${#value}-2}"
  fi
  printf '%s' "$value"
}

assert_runtime_user() {
  [[ "$EUID" -ne 0 ]] || fail "jalankan sebagai $DEPLOYMENT_USER tanpa sudo."
  [[ "$(id -un)" == "$DEPLOYMENT_USER" ]] || fail "runtime Telegram wajib dijalankan sebagai $DEPLOYMENT_USER."
}

for pair in \
  "PROJECT_DIR:$PROJECT_DIR" \
  "ENV_FILE:$ENV_FILE" \
  "COMPOSE_FILE:$COMPOSE_FILE" \
  "STATE_ROOT:$STATE_ROOT" \
  "RELEASE_ENV_FILE:$RELEASE_ENV_FILE"
do
  assert_absolute "${pair%%:*}" "${pair#*:}"
done

case "$ACTION" in
  delivery|reconcile|status)
    [[ $# -eq 1 ]] || { usage >&2; exit 64; }
    ;;
  *)
    usage >&2
    exit 64
    ;;
esac

assert_runtime_user
for command_name in docker grep tail id date install mv chmod dirname; do
  require_command "$command_name"
done

[[ -f "$ENV_FILE" && ! -L "$ENV_FILE" && -r "$ENV_FILE" ]] || fail "production environment tidak dapat dibaca: $ENV_FILE"
[[ -f "$COMPOSE_FILE" && ! -L "$COMPOSE_FILE" && -r "$COMPOSE_FILE" ]] || fail "Compose production tidak dapat dibaca: $COMPOSE_FILE"
[[ -f "$RELEASE_ENV_FILE" && ! -L "$RELEASE_ENV_FILE" && -r "$RELEASE_ENV_FILE" ]] || fail "current release environment tidak dapat dibaca: $RELEASE_ENV_FILE"
[[ -d "$STATE_ROOT" && -w "$STATE_ROOT" ]] || fail "Telegram state directory tidak writable: $STATE_ROOT"

docker info >/dev/null 2>&1 || fail "Docker daemon tidak dapat diakses."
docker compose version >/dev/null 2>&1 || fail "Docker Compose plugin tidak tersedia."

APP_RELEASE_ID_VALUE="$(read_env_file_value "$RELEASE_ENV_FILE" APP_RELEASE_ID)"
APP_REVISION_VALUE="$(read_env_file_value "$RELEASE_ENV_FILE" APP_REVISION)"
APP_BUILD_DATE_VALUE="$(read_env_file_value "$RELEASE_ENV_FILE" APP_BUILD_DATE)"
OPERATIONS_IMAGE="$(read_env_file_value "$RELEASE_ENV_FILE" ASIHJAYA_OPERATIONS_IMAGE)"
INTEGRATION_ENABLED="$(read_env_file_value "$ENV_FILE" TELEGRAM_INTEGRATION_ENABLED)"

[[ "$APP_RELEASE_ID_VALUE" =~ ^[0-9]{8}T[0-9]{6}Z-[a-f0-9]{12}$ ]] || fail "APP_RELEASE_ID current release tidak valid."
[[ "$APP_REVISION_VALUE" =~ ^[a-f0-9]{40,64}$ ]] || fail "APP_REVISION current release tidak valid."
[[ -n "$APP_BUILD_DATE_VALUE" ]] || fail "APP_BUILD_DATE current release kosong."
[[ -n "$OPERATIONS_IMAGE" ]] || fail "ASIHJAYA_OPERATIONS_IMAGE current release kosong."
case "$OPERATIONS_IMAGE" in
  *:latest|*:production) fail "operations image mutable ditolak: $OPERATIONS_IMAGE" ;;
esac

docker image inspect "$OPERATIONS_IMAGE" >/dev/null 2>&1 || fail "operations image current release tidak tersedia: $OPERATIONS_IMAGE"
IMAGE_VERSION="$(docker image inspect --format '{{index .Config.Labels "org.opencontainers.image.version"}}' "$OPERATIONS_IMAGE")"
IMAGE_REVISION="$(docker image inspect --format '{{index .Config.Labels "org.opencontainers.image.revision"}}' "$OPERATIONS_IMAGE")"
[[ "$IMAGE_VERSION" == "$APP_RELEASE_ID_VALUE" ]] || fail "operations image version tidak sama dengan current release."
[[ "$IMAGE_REVISION" == "$APP_REVISION_VALUE" ]] || fail "operations image revision tidak sama dengan current release."

export APP_RELEASE_ID="$APP_RELEASE_ID_VALUE"
export APP_REVISION="$APP_REVISION_VALUE"
export APP_BUILD_DATE="$APP_BUILD_DATE_VALUE"
export ASIHJAYA_OPERATIONS_IMAGE="$OPERATIONS_IMAGE"
export ASIHJAYA_ENV_FILE="$ENV_FILE"

COMPOSE=(
  docker compose
  --env-file "$ENV_FILE"
  -f "$COMPOSE_FILE"
  --profile telegram
)
"${COMPOSE[@]}" config --quiet

write_success_marker() {
  local job="$1" destination="$STATE_ROOT/${job}-success.epoch" temporary
  temporary="${destination}.$$.tmp"
  printf '%s\n' "$(date +%s)" > "$temporary"
  chmod 0640 "$temporary"
  mv -f "$temporary" "$destination"
}

run_job() {
  local job="$1" npm_script="$2"
  "${COMPOSE[@]}" run --rm --no-deps telegram-runtime npm run "$npm_script"
  write_success_marker "$job"
}

query_status() {
  local sql row pending retry failed oldest_age
  sql="select count(*) filter (where status = 'pending'), count(*) filter (where status = 'retry'), count(*) filter (where status = 'failed'), coalesce(extract(epoch from (now() - min(created_at) filter (where status in ('pending','retry'))))::bigint, 0) from telegram_delivery_outbox;"
  row="$("${COMPOSE[@]}" exec -T db sh -lc 'psql -v ON_ERROR_STOP=1 -U "$POSTGRES_USER" -d "$POSTGRES_DB" -At -F "|" -c "$1"' sh "$sql")"
  IFS='|' read -r pending retry failed oldest_age <<< "$row"
  [[ "${pending:-}" =~ ^[0-9]+$ ]] || fail "pending backlog tidak valid."
  [[ "${retry:-}" =~ ^[0-9]+$ ]] || fail "retry backlog tidak valid."
  [[ "${failed:-}" =~ ^[0-9]+$ ]] || fail "failed delivery count tidak valid."
  [[ "${oldest_age:-}" =~ ^[0-9]+$ ]] || fail "oldest pending age tidak valid."

  printf 'integration_enabled=%s\n' "${INTEGRATION_ENABLED:-false}"
  printf 'pending=%s\n' "$pending"
  printf 'retry=%s\n' "$retry"
  printf 'failed=%s\n' "$failed"
  printf 'oldest_pending_age_seconds=%s\n' "$oldest_age"
}

case "$ACTION" in
  delivery) run_job delivery telegram:deliver ;;
  reconcile) run_job reconcile telegram:reconcile-reports ;;
  status) query_status ;;
esac
